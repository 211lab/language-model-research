# Copy to operator/.env. Values here keep the inference endpoint unchanged.
OPENROUTER_API_KEY=
# Optional; needed only when the selected Hugging Face GGUF requires authentication.
HF_TOKEN=
OPERATOR_DB_PORT=55432
OPERATOR_UI_PORT=8090
OPERATOR_API_PORT=8088
LOCAL_AI_BASE_URL=http://localhost:11434

# WSL paths for the existing local inference setup. The local worker is the
# only container granted write access to the switcher and Docker socket.
LLAMA_SWITCHER_ROOT=/home/wsl/llama-model-switcher
HF_CACHE_ROOT=/home/wsl/.cache/huggingface/hub
DOCKER_SOCKET=/var/run/docker.sock

# The platform preserves these comparable-run controls by default.
LOCAL_MODEL_MAX_GIB=20
LOCAL_IDLE_BUFFER_SECONDS=10
LOCAL_SETTLE_SECONDS=10
ASSISTANT_MAX_TOKENS=768
LUNA_MODEL=openai/gpt-5.6-luna
# Luna is the only model used to validate a fresh paid assistant harness.
LUNA_PREFLIGHT_MAX_COST_USD=0.10
EDITORIAL_JUDGE_MODEL=openai/gpt-5.6-luna
EDITORIAL_EVIDENCE_MODEL=deepseek/deepseek-v4-flash
EDITORIAL_TIE_BREAK_MODEL=openai/gpt-5.6-luna

# Daily local-provider discovery and direct-to-main publication. The publisher
# uses the existing Git identity available to the operator host.
DISCOVERY_INTERVAL_SECONDS=86400
DISCOVERY_LOCAL_MODEL_MAX_GIB=32
# Set true only after confirming the local endpoint is idle. Discovery never
# guesses from the model list, and workers still never force-stop inference.
DISCOVERY_IDLE_ACKNOWLEDGED=false
AUTO_PUBLISH_MAIN=true
# Prefer an SSH URL so the publisher can use the existing developer identity.
PUBLISH_REPOSITORY_URL=git@github.com:3f-mindset/language-model-research.git
PUBLISH_SSH_DIR=/home/wsl/.ssh
PUBLISH_GIT_CONFIG=/home/wsl/.gitconfig
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=main
